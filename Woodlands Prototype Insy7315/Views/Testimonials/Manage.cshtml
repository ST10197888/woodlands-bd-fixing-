@model List<Woodlands_Prototype_Insy7315.Models.Testimonial>
@{
    ViewData["Title"] = "Manage Testimonials";
    Layout = "_DashboardLayout";
}

<h1 class="text-xl font-bold text-brand-700 mb-5 display-1">Manage Testimonials</h1>

<div class="grid gap-4">
    @foreach (var t in Model)
    {
        <div class="bg-white rounded-lg border border-gray-100 p-4 flex items-center justify-between">
            <div>
                <p class="font-semibold text-sm">@t.Name — @t.Role</p>
                <p class="text-xs text-gray-500">@t.Review</p>
            </div>
            <div class="flex gap-2">
                <a asp-action="Edit" asp-route-id="@t.Id" class="px-3 py-1.5 text-xs bg-brand-700 text-white rounded">Edit</a>
                <form asp-action="Delete" asp-route-id="@t.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="px-3 py-1.5 text-xs bg-red-600 text-white rounded">Delete</button>
                </form>
            </div>
        </div>
    }
</div>