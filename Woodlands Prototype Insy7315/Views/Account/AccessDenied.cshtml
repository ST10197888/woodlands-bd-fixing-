@{
    ViewData["Title"] = "Access Denied";
}

<div class="max-w-xl mx-auto px-4 py-20 text-center">
    <h1 class="text-3xl font-bold text-brand-700 mb-3" style="font-family:var(--font-display);">Access denied</h1>
    <p class="text-gray-500 mb-6">Your account does not have permission to access this area.</p>
    <a asp-controller="Dashboard" asp-action="Index" class="inline-block bg-brand-700 text-white rounded-lg px-5 py-3 font-semibold">Back to Dashboard</a>
</div>
