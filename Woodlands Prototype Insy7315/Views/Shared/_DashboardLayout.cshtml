@using Microsoft.AspNetCore.Identity
@using Woodlands_Prototype_Insy7315.Models
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var roles = currentUser == null
        ? new List<string>()
        : (await UserManager.GetRolesAsync(currentUser)).ToList();

    var role = roles.FirstOrDefault() ?? "User";

    string roleLabel = role;

    string roleDescription = role switch
    {
        "Admin" => "System Admin",
        "Manager (Soweto)" => "Branch Manager · Soweto",
        "Manager (Roodepoort)" => "Branch Manager · Roodepoort",
        "Manager (Randfontein)" => "Branch Manager · Randfontein",
        "Customer" => "Customer",
        _ => role
    };
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        @ViewData["Title"] - Woodlands Dashboard
    </title>

    <partial name="_ThemeHead" />

    <link rel="icon" href="~/Images/brand/woodlands-mark.png" type="image/png" />

</head>

<body class="bg-surface">

    <div class="min-h-screen flex">

        <!-- SIDEBAR -->

        <aside class="hidden lg:flex flex-col w-64 bg-brand-900 text-white shrink-0">

            <div class="px-5 py-6 border-b border-white/10">

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="text-white font-bold text-lg"
                   style="font-family:var(--font-display);">
                    Woodlands
                </a>

                <p class="text-white/40 text-xs mt-1">
                    Designer Boards
                </p>

            </div>

            <!-- User -->

            <div class="mx-4 mt-4 p-3 rounded-lg bg-white/10">

                <div class="flex items-center gap-3">

                    <div class="w-9 h-9 rounded-full bg-accent flex items-center justify-center text-white font-bold text-xs">
                        @{
                            var initials = currentUser?.FullName
                                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                .Take(2)
                                .Select(x => x[0])
                                .ToArray();

                            @(initials == null
                                ? "U"
                                : new string(initials))
                        }
                    </div>

                    <div class="min-w-0">

                        <p class="text-sm font-semibold truncate">
                            @currentUser?.FullName
                        </p>

                        <p class="text-xs text-white/50 truncate">
                            @roleDescription
                        </p>

                    </div>

                </div>

            </div>

            <!-- Navigation -->

            <nav class="flex-1 px-3 py-4 space-y-1">

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="block px-3 py-2.5 rounded-lg text-sm text-white/75 hover:text-white hover:bg-white/10">
                    Dashboard
                </a>

                @if (User.IsInRole("Admin") ||
                     User.IsInRole("Manager (Soweto)") ||
                     User.IsInRole("Manager (Roodepoort)") ||
                     User.IsInRole("Manager (Randfontein)") ||
                     User.IsInRole("Customer"))
                {
                    <a asp-controller="Dashboard"
                       asp-action="Quotes"
                       class="block px-3 py-2.5 rounded-lg text-sm text-white/75 hover:text-white hover:bg-white/10">
                        Quotes
                    </a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin"
                       asp-action="Users"
                       class="block px-3 py-2.5 rounded-lg text-sm text-white/75 hover:text-white hover:bg-white/10">
                        Users
                    </a>
                }

                @if (User.IsInRole("Admin") ||
                     User.IsInRole("Manager (Soweto)") ||
                     User.IsInRole("Manager (Roodepoort)") ||
                     User.IsInRole("Manager (Randfontein)"))
                {
                    <a asp-controller="Management"
                       asp-action="Products"
                       class="block px-3 py-2.5 rounded-lg text-sm text-white/75 hover:text-white hover:bg-white/10">

                        Products
                    </a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Dashboard"
                       asp-action="Analytics"
                       class="block px-3 py-2.5 rounded-lg text-sm text-white/75 hover:text-white hover:bg-white/10">

                        Analytics
                    </a>
                }

                @if (User.IsInRole("Manager (Soweto)") ||
                     User.IsInRole("Manager (Roodepoort)") ||
                     User.IsInRole("Manager (Randfontein)"))
                {
                    <a asp-controller="Dashboard"
                       asp-action="Customers"
                       class="block px-3 py-2.5 rounded-lg text-sm text-white/75 hover:text-white hover:bg-white/10">

                        Customers
                    </a>
                }

                <a asp-controller="Dashboard"
                   asp-action="Settings"
                   class="block px-3 py-2.5 rounded-lg text-sm text-white/75 hover:text-white hover:bg-white/10">
                    Settings
                </a>

            </nav>

            <div class="px-3 py-4 border-t border-white/10">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="block px-3 py-2.5 rounded-lg text-sm text-white/60 hover:text-white hover:bg-white/10 mb-1">
                    ← Back to Site
                </a>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="w-full text-left px-3 py-2.5 rounded-lg text-sm text-white/60 hover:text-white hover:bg-white/10">
                        Sign Out
                    </button>

                </form>

            </div>

        </aside>

        <!-- MAIN -->

        <div class="flex-1 min-w-0">

            <header class="h-16 bg-white border-b border-gray-100 flex items-center justify-end px-5 shadow-sm">

                <div class="flex items-center gap-4">

                    <div class="hidden sm:block text-right">

                        <p class="text-sm font-semibold text-gray-700">
                            @currentUser?.FullName
                        </p>

                        <p class="text-xs text-gray-400">
                            @roleDescription
                        </p>

                    </div>

                    <div class="w-9 h-9 rounded-full bg-brand-700 text-white flex items-center justify-center text-xs font-bold">

                        @{
                            var topInitials = currentUser?.FullName
                                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                .Take(2)
                                .Select(x => x[0])
                                .ToArray();

                            @(topInitials == null
                                ? "U"
                                : new string(topInitials))
                        }

                    </div>

                </div>

            </header>

            <main class="p-5 lg:p-8">

                @RenderBody()

            </main>

        </div>

    </div>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>