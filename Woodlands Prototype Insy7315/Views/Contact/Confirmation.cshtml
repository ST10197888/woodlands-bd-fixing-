@{
    ViewData["Title"] = "Thank You";
}

<div class="min-h-screen bg-white flex items-center justify-center px-4 py-20">
    <div class="bg-white rounded-xl border border-line p-12 text-center max-w-md">
        <div class="w-16 h-16 bg-brand-700 rounded-full flex items-center justify-center mx-auto mb-5 text-accent text-2xl">&#10003;</div>
        <h3 class="text-brand-700 mb-2" style="font-weight:700;font-size:1.4rem;">Quote Request Sent!</h3>
        <p class="text-muted text-sm mb-6 max-w-xs mx-auto" style="line-height:1.7;">
            Thank you! We'll contact you within one business day to discuss your project in detail.
        </p>
        <a asp-controller="Contact" asp-action="Index" class="inline-block px-5 py-2.5 bg-brand-700 text-white text-sm font-semibold rounded-lg hover:bg-brand-600 transition-colors">
            Submit Another Enquiry
        </a>
    </div>
</div>
