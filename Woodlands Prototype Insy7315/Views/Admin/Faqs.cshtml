@model IEnumerable<Woodlands_Prototype_Insy7315.Models.FaqItem>
@{
    ViewData["Title"] = "FAQs";
}

<div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
            <h1 class="text-3xl font-bold text-brand-700" style="font-family:var(--font-display);">FAQs</h1>
            <p class="text-sm text-gray-500 mt-1">Only admins can create, edit or delete FAQs.</p>
        </div>
        <a asp-action="CreateFaq" class="btn btn-secondary">Add FAQ</a>
    </div>

    <div class="space-y-4">
        @foreach (var faq in Model)
        {
            <div class="bg-white border border-gray-100 rounded-xl shadow-sm p-5">
                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                    <div>
                        <span class="inline-block px-2 py-0.5 bg-brand-700/8 rounded text-brand-700 text-xs font-medium mb-2">@faq.Category</span>
                        <h2 class="font-bold text-brand-700 display-2">@faq.Question</h2>
                        <p class="text-sm text-gray-700 mt-2">@faq.Answer</p>
                    </div>
                    <div class="flex items-center gap-4 shrink-0">
                        <a asp-action="EditFaq" asp-route-id="@faq.Id" class="text-brand-700 font-semibold">Edit</a>
                        <form asp-action="DeleteFaq" method="post" onsubmit="return confirm('Delete this FAQ?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@faq.Id" />
                            <button type="submit" class="text-accent font-semibold">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
