@model IEnumerable<Woodlands_Prototype_Insy7315.Models.Testimonial>
@{
    ViewData["Title"] = "Testimonials";
}

<div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
            <h1 class="text-3xl font-bold text-brand-700" style="font-family:var(--font-display);">Testimonials</h1>
            <p class="text-sm text-gray-500 mt-1">Only admins can create, edit or delete testimonials.</p>
        </div>
        <a asp-action="CreateTestimonial" class="btn btn-secondary">Add Testimonial</a>
    </div>

    <div class="space-y-4">
        @foreach (var testimonial in Model)
        {
            <div class="bg-white border border-gray-100 rounded-xl shadow-sm p-5">
                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                    <div>
                        <h2 class="font-bold text-brand-700 display-2">@testimonial.Name</h2>
                        <p class="text-xs text-gray-500">@testimonial.Role · @testimonial.Location · @testimonial.Project</p>
                        <p class="text-sm text-gray-700 mt-3">@testimonial.Review</p>
                        <p class="text-sm text-accent mt-2">Rating: @testimonial.Rating / 5</p>
                    </div>
                    <div class="flex items-center gap-4 shrink-0">
                        <a asp-action="EditTestimonial" asp-route-id="@testimonial.Id" class="text-brand-700 font-semibold">Edit</a>
                        <form asp-action="DeleteTestimonial" method="post" onsubmit="return confirm('Delete this testimonial?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@testimonial.Id" />
                            <button type="submit" class="text-accent font-semibold">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
