@model Woodlands_Prototype_Insy7315.Models.TestimonialFormViewModel
@{
    var editing = Model.Id != 0;
    ViewData["Title"] = editing ? "Edit Testimonial" : "Add Testimonial";
}

<div class="max-w-2xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-brand-700 mb-6" style="font-family:var(--font-display);">@ViewData["Title"]</h1>
    <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 mb-4"></div>

    <form asp-action="@(editing ? "EditTestimonial" : "CreateTestimonial")" asp-route-id="@Model.Id" method="post" class="bg-white border border-gray-100 rounded-xl shadow-sm p-6 space-y-5">
        @Html.AntiForgeryToken()

        <div>
            <label asp-for="Name" class="field-label"></label>
            <input asp-for="Name" class="field" />
            <span asp-validation-for="Name" class="text-xs text-red-600"></span>
        </div>

        <div class="grid md:grid-cols-2 gap-5">
            <div>
                <label asp-for="Role" class="field-label"></label>
                <input asp-for="Role" class="field" />
            </div>
            <div>
                <label asp-for="Location" class="field-label"></label>
                <input asp-for="Location" class="field" />
            </div>
        </div>

        <div>
            <label asp-for="Project" class="field-label"></label>
            <input asp-for="Project" class="field" />
        </div>

        <div>
            <label asp-for="Rating" class="field-label"></label>
            <select asp-for="Rating" class="field">
                @for (var i = 1; i <= 5; i++)
                {
                    <option value="@i">@i / 5</option>
                }
            </select>
        </div>

        <div>
            <label asp-for="Review" class="field-label"></label>
            <textarea asp-for="Review" rows="6" class="field"></textarea>
            <span asp-validation-for="Review" class="text-xs text-red-600"></span>
        </div>

        <div class="flex gap-3">
            <button type="submit" class="btn btn-secondary">Save Testimonial</button>
            <a asp-action="Testimonials" class="px-5 py-2.5 rounded-lg border border-gray-200 font-semibold">Cancel</a>
        </div>
    </form>
</div>
