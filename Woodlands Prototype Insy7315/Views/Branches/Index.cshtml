@model IEnumerable<Woodlands_Prototype_Insy7315.Models.Branch>

@{
    ViewData["Title"] = "Our Branches";
}

<div class="container mt-4">
    <h1>Our Branches</h1>
    <hr />

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Region</th>
                <th>Phone</th>
                <th>Hours</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var branch in Model)
            {
                <tr>
                    <td>@branch.Name</td>
                    <td>@branch.Region</td>
                    <td>@branch.Phone</td>
                    <td>@branch.Hours</td>
                    <td>@branch.Notes</td>
                </tr>
            }
        </tbody>
    </table>
</div>