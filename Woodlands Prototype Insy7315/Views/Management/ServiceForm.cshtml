@model Woodlands_Prototype_Insy7315.Models.Service
@{
    var editing = Model.Id != 0;
    ViewData["Title"] = editing ? "Edit Service" : "Add Service";
}

<div class="max-w-2xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-brand-700 mb-6" style="font-family:var(--font-display);">@ViewData["Title"]</h1>
    <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 mb-4"></div>

    <form asp-action="@(editing ? "EditService" : "CreateService")" asp-route-id="@Model.Id" method="post" class="bg-white border border-gray-100 rounded-xl shadow-sm p-6 space-y-5">
        @Html.AntiForgeryToken()

        <div>
            <label asp-for="Name" class="field-label"></label>
            <input asp-for="Name" class="field" />
            <span asp-validation-for="Name" class="text-xs text-red-600"></span>
        </div>

        <div>
            <label asp-for="Description" class="field-label"></label>
            <textarea asp-for="Description" rows="5" class="field"></textarea>
        </div>

        <div>
            <label asp-for="Image" class="field-label"></label>
            <input asp-for="Image" class="field" />
        </div>

        <label class="flex items-center gap-2 text-sm">
            <input asp-for="IsActive" />
            Active service
        </label>

        <div class="flex gap-3">
            <button type="submit" class="btn btn-secondary">Save Service</button>
            <a asp-action="Services" class="px-5 py-2.5 rounded-lg border border-gray-200 font-semibold">Cancel</a>
        </div>
    </form>
</div>
