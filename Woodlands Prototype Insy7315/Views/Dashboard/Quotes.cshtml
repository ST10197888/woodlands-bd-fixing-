@{
    ViewData["Title"] = "Quotes";
    Layout = "_DashboardLayout";
}

<div class="mb-7">

    <h1 class="text-3xl font-bold text-brand-700"
        style="font-family:var(--font-display);">
        Quotes
    </h1>

    <p class="text-gray-500 text-sm mt-1">
        Quote activity for the current account.
    </p>

</div>

@if (TempData["DashboardMessage"] != null)
{
    <div class="mb-5 p-4 rounded-lg bg-green-50 border border-green-100 text-green-700 text-sm">
        @TempData["DashboardMessage"]
    </div>
}

<div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">

    <div class="overflow-x-auto">

        <table class="w-full text-sm">

            <thead class="bg-gray-50 border-b border-gray-100">

                <tr>

                    <th class="text-left px-5 py-3 text-xs uppercase tracking-wider text-gray-400">
                        Quote
                    </th>

                    <th class="text-left px-5 py-3 text-xs uppercase tracking-wider text-gray-400">
                        Service
                    </th>

                    <th class="text-left px-5 py-3 text-xs uppercase tracking-wider text-gray-400">
                        Branch
                    </th>

                    <th class="text-left px-5 py-3 text-xs uppercase tracking-wider text-gray-400">
                        Status
                    </th>

                    @if (!User.IsInRole("Customer"))
                    {
                        <th class="text-right px-5 py-3 text-xs uppercase tracking-wider text-gray-400">
                            Action
                        </th>
                    }

                </tr>

            </thead>

            <tbody class="divide-y divide-gray-50">

                <tr>

                    <td class="px-5 py-4 font-mono text-xs text-gray-500">
                        QT-0035
                    </td>

                    <td class="px-5 py-4 font-medium text-gray-700">
                        TV Stand / Entertainment Unit
                    </td>

                    <td class="px-5 py-4 text-gray-500">
                        Soweto
                    </td>

                    <td class="px-5 py-4">

                        <span class="px-2.5 py-1 rounded-full bg-amber-100 text-amber-700 text-xs font-semibold">
                            Pending
                        </span>

                    </td>

                    @if (!User.IsInRole("Customer"))
                    {
                        <td class="px-5 py-4 text-right">

                            <form asp-action="UpdateQuoteStatus"
                                  method="post"
                                  class="inline-flex gap-2">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="quoteId"
                                       value="QT-0035" />

                                <input type="hidden"
                                       name="status"
                                       value="In Progress" />

                                <button type="submit"
                                        class="px-3 py-1.5 bg-brand-700 text-white rounded text-xs font-semibold">
                                    Start
                                </button>

                            </form>

                        </td>
                    }

                </tr>

                <tr>

                    <td class="px-5 py-4 font-mono text-xs text-gray-500">
                        QT-0022
                    </td>

                    <td class="px-5 py-4 font-medium text-gray-700">
                        Built-In Cupboards
                    </td>

                    <td class="px-5 py-4 text-gray-500">
                        Soweto
                    </td>

                    <td class="px-5 py-4">

                        <span class="px-2.5 py-1 rounded-full bg-green-100 text-green-700 text-xs font-semibold">
                            Completed
                        </span>

                    </td>

                    @if (!User.IsInRole("Customer"))
                    {
                        <td class="px-5 py-4 text-right text-xs text-gray-400">
                            Complete
                        </td>
                    }

                </tr>

            </tbody>

        </table>

    </div>

</div>

@if (User.IsInRole("Customer"))
{
    <div class="mt-6">

        <a asp-controller="Contact"
           asp-action="Index"
           class="btn btn-primary">
            Request a New Quote
        </a>

    </div>
}