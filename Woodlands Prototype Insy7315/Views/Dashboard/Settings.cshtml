@using Microsoft.AspNetCore.Identity
@using Woodlands_Prototype_Insy7315.Models
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Settings";
    Layout = "_DashboardLayout";

    var currentUser = await UserManager.GetUserAsync(User);
    var roles = currentUser == null
        ? new List<string>()
        : (await UserManager.GetRolesAsync(currentUser)).ToList();
}

<div class="mb-7">

    <h1 class="text-3xl font-bold text-brand-700"
        style="font-family:var(--font-display);">
        Settings
    </h1>

    <p class="text-gray-500 text-sm mt-1">
        Account and application settings.
    </p>

</div>

<div class="grid lg:grid-cols-2 gap-6">

    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">

        <h2 class="text-lg font-bold text-gray-800"
            style="font-family:var(--font-display);">
            My Account
        </h2>

        <div class="mt-5 space-y-4">

            <div>
                <p class="text-xs uppercase tracking-wider text-gray-400">
                    Name
                </p>

                <p class="text-sm font-semibold text-gray-700 mt-1">
                    @currentUser?.FullName
                </p>
            </div>

            <div>
                <p class="text-xs uppercase tracking-wider text-gray-400">
                    Email
                </p>

                <p class="text-sm font-semibold text-gray-700 mt-1">
                    @currentUser?.Email
                </p>
            </div>

            <div>
                <p class="text-xs uppercase tracking-wider text-gray-400">
                    Role
                </p>

                <p class="text-sm font-semibold text-brand-700 mt-1">
                    @roles.FirstOrDefault()
                </p>
            </div>

            <div>
                <p class="text-xs uppercase tracking-wider text-gray-400">
                    Branch
                </p>

                <p class="text-sm font-semibold text-gray-700 mt-1">
                    @(currentUser?.Branch ?? "All branches / Not applicable")
                </p>
            </div>

        </div>

    </div>

    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">

        <h2 class="text-lg font-bold text-gray-800"
            style="font-family:var(--font-display);">
            Security
        </h2>

        <div class="mt-5 space-y-4">

            <div class="p-4 bg-green-50 border border-green-100 rounded-lg">

                <p class="text-sm font-semibold text-green-700">
                    Password hashing enabled
                </p>

                <p class="text-xs text-green-600 mt-1">
                    Passwords are managed by ASP.NET Core Identity.
                </p>

            </div>

            <div class="p-4 bg-green-50 border border-green-100 rounded-lg">

                <p class="text-sm font-semibold text-green-700">
                    Account lockout enabled
                </p>

                <p class="text-xs text-green-600 mt-1">
                    Repeated failed sign-in attempts temporarily lock accounts.
                </p>

            </div>

            <div class="p-4 bg-green-50 border border-green-100 rounded-lg">

                <p class="text-sm font-semibold text-green-700">
                    Server-side authorization enabled
                </p>

                <p class="text-xs text-green-600 mt-1">
                    Dashboard permissions are enforced by MVC controllers.
                </p>

            </div>

        </div>

    </div>

</div>