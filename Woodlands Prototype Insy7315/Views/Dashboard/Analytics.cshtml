@{
    ViewData["Title"] = "Analytics";
    Layout = "_DashboardLayout";
}

<div class="mb-7">

    <h1 class="text-3xl font-bold text-brand-700"
        style="font-family:var(--font-display);">
        Analytics
    </h1>

    <p class="text-gray-500 text-sm mt-1">
        Branch and system performance overview.
    </p>

</div>

<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">

    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
        <p class="text-xs text-gray-400 uppercase tracking-wider">
            Weekly Revenue
        </p>

        <p class="text-3xl font-bold text-brand-700 mt-2">
            R64.5k
        </p>

        <p class="text-xs text-green-600 mt-1">
            Prototype metric
        </p>
    </div>

    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
        <p class="text-xs text-gray-400 uppercase tracking-wider">
            Quotes
        </p>

        <p class="text-3xl font-bold text-brand-700 mt-2">
            12
        </p>

        <p class="text-xs text-gray-400 mt-1">
            Current prototype data
        </p>
    </div>

    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
        <p class="text-xs text-gray-400 uppercase tracking-wider">
            Completed
        </p>

        <p class="text-3xl font-bold text-green-600 mt-2">
            7
        </p>

        <p class="text-xs text-gray-400 mt-1">
            Current prototype data
        </p>
    </div>

    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
        <p class="text-xs text-gray-400 uppercase tracking-wider">
            Branches
        </p>

        <p class="text-3xl font-bold text-accent mt-2">
            3
        </p>

        <p class="text-xs text-gray-400 mt-1">
            Soweto · Roodepoort · Randfontein
        </p>
    </div>

</div>

<div class="mt-6 bg-white rounded-xl border border-gray-100 shadow-sm p-6">

    <h2 class="text-lg font-bold text-gray-800"
        style="font-family:var(--font-display);">
        Weekly Revenue
    </h2>

    <div class="mt-6 grid grid-cols-6 gap-3 items-end h-56">

        <div class="flex flex-col items-center justify-end h-full">
            <div class="w-full max-w-12 bg-brand-700 rounded-t"
                 style="height:45%;"></div>
            <span class="text-xs text-gray-400 mt-2">Mon</span>
        </div>

        <div class="flex flex-col items-center justify-end h-full">
            <div class="w-full max-w-12 bg-brand-700 rounded-t"
                 style="height:55%;"></div>
            <span class="text-xs text-gray-400 mt-2">Tue</span>
        </div>

        <div class="flex flex-col items-center justify-end h-full">
            <div class="w-full max-w-12 bg-brand-700 rounded-t"
                 style="height:40%;"></div>
            <span class="text-xs text-gray-400 mt-2">Wed</span>
        </div>

        <div class="flex flex-col items-center justify-end h-full">
            <div class="w-full max-w-12 bg-brand-700 rounded-t"
                 style="height:70%;"></div>
            <span class="text-xs text-gray-400 mt-2">Thu</span>
        </div>

        <div class="flex flex-col items-center justify-end h-full">
            <div class="w-full max-w-12 bg-accent rounded-t"
                 style="height:85%;"></div>
            <span class="text-xs text-gray-400 mt-2">Fri</span>
        </div>

        <div class="flex flex-col items-center justify-end h-full">
            <div class="w-full max-w-12 bg-brand-700 rounded-t"
                 style="height:25%;"></div>
            <span class="text-xs text-gray-400 mt-2">Sat</span>
        </div>

    </div>

</div>